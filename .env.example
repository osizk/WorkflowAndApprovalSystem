# Local app/Compose values. Replace every placeholder in an ignored .env file.
PORT=3000
PUBLIC_ORIGIN=http://localhost:18080
DATABASE_URL=postgresql://workflow:replace-with-local-password@localhost:5432/workflow_dev
POSTGRES_PASSWORD=replace-with-local-password

# Only needed when creating the four local demo accounts.
SEED_REQUESTER1_PASSWORD=replace-with-local-password
SEED_REQUESTER2_PASSWORD=replace-with-local-password
SEED_REVIEWER1_PASSWORD=replace-with-local-password
SEED_REVIEWER2_PASSWORD=replace-with-local-password

# Test-only; keep the database name ending in _test.
TEST_DATABASE_URL=postgresql://workflow:replace-with-local-password@localhost:5432/workflow_test
WORKFLOW_BROWSER_CHANNEL=
