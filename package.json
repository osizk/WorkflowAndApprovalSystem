{
  "name": "workflow-and-approval-system",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build client --outDir ../client-dist --emptyOutDir",
    "start": "node dist/server.js",
    "test:auth": "npm run build && node --test tests/auth.test.mjs tests/auth-safety.test.mjs",
    "test:auth-safety": "npm run build && node --test tests/auth-safety.test.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node scripts/seed.mjs",
    "db:test:setup": "node scripts/test-db.mjs",
    "test:db-guard": "node --test tests/test-db.test.mjs",
    "test:auth-ui": "npm run build && node --test tests/auth-ui.test.mjs",
    "test:requests": "npm run build && node --test tests/requests.test.mjs",
    "test:request-ui": "npm run build && node --test tests/request-ui.test.mjs",
    "test:decisions": "npm run build && node --test tests/decisions.test.mjs",
    "test:review-ui": "npm run build && node --test tests/review-ui.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "express": "5.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.65.0",
    "prisma": "6.19.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
