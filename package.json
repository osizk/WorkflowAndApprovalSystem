{
  "name": "workflow-and-approval-system",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test:auth": "npm run build && node --test tests/auth.test.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node scripts/seed.mjs",
    "db:test:setup": "node scripts/test-db.mjs",
    "test:db-guard": "node --test tests/test-db.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "prisma": "6.19.0",
    "typescript": "5.9.3"
  }
}
